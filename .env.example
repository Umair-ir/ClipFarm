# Any setting in config/settings.yaml can be overridden as CLIPFARM_<SECTION>_<KEY>.
# Copy to .env (the installer does this) and uncomment what you need.

# CLIPFARM_WHISPER_MODEL=medium        # better accuracy, ~2x slower, ~1.5 GB RAM
# CLIPFARM_WHISPER_LANGUAGE=en         # skip language detection
# CLIPFARM_OLLAMA_MODEL=llama3.2:3b
# CLIPFARM_HIGHLIGHTS_MAX_CLIPS_PER_VOD=10
# CLIPFARM_RENDER_ZOOM=0

# Silences the Hugging Face "unauthenticated requests" warning on first model download (optional).
# HF_TOKEN=
